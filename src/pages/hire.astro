---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

---

<BaseLayout
  title="Hire MD Anik Hasan for Website or Software Development"
  description="Want a website or custom software built? Here's what to send me. I work in Bangladesh and remotely."
>
  <PageHero
    eyebrow="Start a project"
    title="What do you want to build?"
    intro="Keep the first message short. Tell me what you want, what you have now, what it needs, and when you need it."
    showGauge={false}
  />

  <section class="intake-guide" aria-labelledby="intake-title">
    <div>
      <p class="eyebrow">Your message</p>
      <h2 id="intake-title">What to include</h2>
    </div>
    <ol>
      <li>
        <h3>What you want</h3>
        <p>What should it do for you or your customers?</p>
      </li>
      <li>
        <h3>What you have now</h3>
        <p>An old website, a spreadsheet, work you do by hand?</p>
      </li>
      <li>
        <h3>What it needs</h3>
        <p>Main pages or features, other tools it should connect to, anything private.</p>
      </li>
      <li>
        <h3>When</h3>
        <p>
          Your deadline, or just say it's flexible.
        </p>
      </li>
      <li>
        <h3>How to reach you</h3>
        <p>
          A budget helps if you have one. Skip it if you don't.
        </p>
      </li>
    </ol>
  </section>

  <section class="plain-section">
    <h2>What I do</h2>
    <p>
      Websites, web apps, desktop software and automation. If your project is something else, I'll tell you.
    </p>
  </section>

  <section class="plain-section">
    <h2>Send it</h2>
    <p>
      Use the <a href="/contact/">contact page</a>, or message me on <a href={SITE.discord}>Discord</a>.
    </p>
  </section>
</BaseLayout>
