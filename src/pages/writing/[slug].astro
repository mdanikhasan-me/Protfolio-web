---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';

interface Props {
  article: CollectionEntry<'articles'>;
}

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const route = `/writing/${article.id}/`;
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Writing', href: '/writing/' },
  { label: article.data.title },
];
const formatter = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout
  title={`${article.data.title} | MD Anik Hasan`}
  description={article.data.description}
  canonicalPath={route}
  type="article"
  schema={[
    breadcrumbSchema(breadcrumbs),
    articleSchema({
      title: article.data.title,
      description: article.data.description,
      route,
      publishedAt: article.data.publishedAt,
      ...(article.data.updatedAt ? { updatedAt: article.data.updatedAt } : {}),
    }),
  ]}
>
  <Breadcrumbs items={breadcrumbs} />
  <PageHero
    eyebrow="Field note"
    title={article.data.title}
    intro={article.data.description}
    workshop="Field Notes"
    meta={[
      `Published ${formatter.format(article.data.publishedAt)}`,
      `By MD Anik Hasan`,
      ...article.data.topics,
    ]}
  />

  <div class="content-layout article-layout">
    <aside class="content-rail" aria-label="Article contents">
      {
        toc.length > 0 && (
          <nav class="toc" aria-labelledby="toc-title">
            <p class="rail-label" id="toc-title">
              On this page
            </p>
            <ol>
              {toc.map((heading) => (
                <li class:list={['toc-item', `toc-depth-${heading.depth}`]}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <a href="/about/">About the author</a>
    </aside>
    <article class="prose">
      <Content />
    </article>
  </div>

  <section class="article-next" aria-labelledby="article-next-title">
    <p class="eyebrow">Continue through the workshop</p>
    <h2 id="article-next-title">See the work behind the note.</h2>
    <p>
      {
        article.data.relatedProject === 'salty-potato-ai' ? (
          <a href="/lab/salty-potato-ai/">Open the Salty Potato AI build log</a>
        ) : article.data.relatedProject === 'uiu-discord-bot' ? (
          <a href="/work/uiu-discord-bot/">Open the UIU Discord Bot case study</a>
        ) : (
          <a href="/work/">Browse verified work</a>
        )
      }
    </p>
  </section>
</BaseLayout>
