  description="Résumé for MD Anik Hasan, a full-stack web and software developer, founder of Boilabin, and CSE student at United International University."
>
  <PageHero
    eyebrow="Résumé"
    title="MD Anik Hasan"
    intro="Full-stack web and software developer, founder of Boilabin, and Computer Science and Engineering student at United International University."
    workshop="Build Record"
  />

  <article class="resume-sheet">
    <header>
      <h2>MD Anik Hasan</h2>
      <p>Full-stack web and software developer · Founder of Boilabin</p>
      <p>Dhaka, Bangladesh · <a href="https://mdanikhasan.com">mdanikhasan.com</a></p>
    </header>

    <section aria-labelledby="resume-summary">
      <h3 id="resume-summary">Summary</h3>
      <p>
        I build web and software products, including Boilabin, a Bangladesh-focused ecommerce
        marketplace I founded, built, and currently run. I’m studying Computer Science and
        Engineering at United International University.
      </p>
