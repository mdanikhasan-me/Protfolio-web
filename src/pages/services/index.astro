---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Website and Software Development Services | MD Anik Hasan"
  description="Website development and custom software development from MD Anik Hasan in Dhaka, Bangladesh, with focused native Windows capability."
>
  <PageHero
    eyebrow="Commission desk"
    title="Two services, one careful build process."
    intro="I take on website development and custom software projects. Native Windows work is the strongest specific software capability I can currently prove in public."
    workshop="Commission Desk"
  />

  <section class="collection-list" aria-labelledby="service-list-title">
    <h2 id="service-list-title">Choose the problem you need to solve</h2>
    <ol>
      {
        services.map((service) => (
          <li>
            <p class="list-index">{String(service.data.order).padStart(2, '0')}</p>
            <div>
              <p class="workshop-label">{service.data.workshop}</p>
              <h3>
                <a href={`/services/${service.id}/`}>{service.data.title}</a>
              </h3>
              <p>{service.data.intro}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="plain-section">
    <p class="eyebrow">Not the right category?</p>
    <h2>Start with the workflow.</h2>
    <p>
      If you are unsure whether the work is a website or custom software project, describe the goal
      and current process. I will keep the response inside the services I actually offer.
    </p>
  </section>
</BaseLayout>
