---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Website and Software Development Services | MD Anik Hasan"
  description="Full-stack website development and custom software from MD Anik Hasan, including web apps, ecommerce, dashboards, automation, and native Windows tools."
>
  <PageHero
    eyebrow="Services"
    title="Two kinds of work, handled from front to back."
    intro="I build full-stack websites and web applications, and I make custom software for work that does not fit comfortably inside a browser."
    workshop="Project Services"
  />

  <section class="collection-list" aria-labelledby="service-list-title">
    <h2 id="service-list-title">What do you need to build?</h2>
    <ol>
      {
        services.map((service) => (
          <li>
            <p class="list-index">{String(service.data.order).padStart(2, '0')}</p>
            <div>
              <p class="workshop-label">{service.data.workshop}</p>
              <h3>
                <a href={`/services/${service.id}/`}>{service.data.title}</a>
              </h3>
              <p>{service.data.intro}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="plain-section">
    <p class="eyebrow">Not sure which one fits?</p>
    <h2>Start with what needs to work.</h2>
    <p>
      Describe what you are building, who it is for, and what the finished product needs to do. I
      can help work out whether that belongs on the web or in a focused software tool.
    </p>
  </section>
</BaseLayout>
