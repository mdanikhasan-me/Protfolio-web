---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const serviceLabels: Record<string, string> = {
  'website-development': 'Web',
  'custom-software-development': 'Software',
  'native-windows-software': 'Windows',
};
---

<BaseLayout
  title="Website and Software Development Services | MD Anik Hasan"
  description="Websites, web apps, online stores, dashboards, automation and Windows desktop software."
>
  <PageHero
    eyebrow="Services"
    title="Services"
    intro="I build websites and web apps. When a job doesn't suit a browser, I build software for it."
    workshop="Websites and software"
    showGauge={false}
  />

  <section class="service-features" aria-labelledby="service-list-title">
    <div class="service-features-heading">
      <h2 id="service-list-title">What do you need?</h2>
      <p class="studio-bengali" lang="bn">কী বানাতে চান, বলুন।</p>
    </div>
    <ol class="service-feature-grid">
      {
        services.map((service) => (
          <li class="service-feature">
            <a href={`/services/${service.id}/`} aria-labelledby={`service-${service.id}`}>
              <div class="service-feature-meta" aria-hidden="true">
                <span>{String(service.data.order).padStart(2, '0')}</span>
                <span>{service.data.workshop}</span>
                <span class="service-feature-arrow">↗</span>
              </div>
              <div class="service-feature-visual" aria-hidden="true">
                <div class="service-feature-marquee">
                  <span>{`${serviceLabels[service.id] || service.data.title} / `.repeat(3)}</span>
                  <span>{`${serviceLabels[service.id] || service.data.title} / `.repeat(3)}</span>
                </div>
                <span class="service-feature-word">{serviceLabels[service.id] || service.data.title}</span>
              </div>
              <div class="service-feature-detail">
                <h3 id={`service-${service.id}`}>{service.data.title}</h3>
                <p>{service.data.intro}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="plain-section">
    <p class="eyebrow">Not sure which one you need?</p>
    <h2>Just tell me what it should do.</h2>
    <p>
      Tell me what you're making and who it's for. I'll say whether it should be a website or a desktop app.
    </p>
  </section>
</BaseLayout>
