---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Selected Software and Website Projects | MD Anik Hasan"
  description="Boilabin, SoctuKit, UIU Discord Bot, and Salty Potato AI: selected web, desktop, automation, and language-model work by MD Anik Hasan."
>
  <PageHero
    eyebrow="Selected work"
    title="A few things I’ve built and continue to work on."
    intro="Some are products I run, some are focused tools, and one is an experiment still very much in progress. Each page explains what the project actually does."
    workshop="Project Archive"
  />

  <section class="collection-list" aria-labelledby="project-list-title">
    <h2 id="project-list-title">Selected projects</h2>
    <ol>
      {
        projects.map((project) => (
          <li>
            <p class="list-index">{String(project.data.order).padStart(2, '0')}</p>
            <div>
              <p class="workshop-label">
                {project.data.workshop} · {project.data.status}
              </p>
              <h3>
                <a href={project.data.route}>{project.data.title}</a>
              </h3>
              <p>{project.data.description}</p>
              <p class="list-meta">
                {project.data.kind} · {project.data.role}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
