---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { websiteSchema } from '../lib/schema';

const services = (await getCollection('services', ({ data }) => !data.draft))
  .filter((entry) => ['website-development', 'custom-software-development'].includes(entry.id))
  .sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);
const leadProject = projects.find((project) => project.id === 'boilabin') ?? projects[0];
if (!leadProject) throw new Error('At least one published project is required.');

const mediaBase: Record<string, string> = {
  boilabin: '/media/projects/boilabin-preview',
  soctukit: '/media/projects/soctukit',
  'uiu-discord-bot': '/media/projects/uiu-discord-bot',
  'salty-potato-ai': '/media/projects/salty-potato-ai',
};
---

<BaseLayout bodyClass="home-page home-v5" schema={websiteSchema()}>
  <section class="v5-hero" aria-labelledby="home-title" data-v5-hero>
    <div class="v5-hero-grid" aria-hidden="true"></div>
    <div class="v5-hero-plane v5-hero-plane-a" aria-hidden="true"></div>
    <div class="v5-hero-plane v5-hero-plane-b" aria-hidden="true"></div>

    <div class="v5-hero-meta">
      <p>Dhaka / Bangladesh</p>
      <p>Websites + custom software</p>
      <p>Portfolio / 2026</p>
    </div>

    <h1 class="v5-hero-name" id="home-title">
      <span>MD ANIK</span>
      <span>HASAN</span>
    </h1>

    <a
      class="v5-hero-project"
      href={leadProject.data.route}
      aria-label={`Open ${leadProject.data.title}`}
    >
      <picture>
        <source media="(max-width: 720px)" srcset={`${mediaBase[leadProject.id]}-960.webp`} />
        <img
          src={`${mediaBase[leadProject.id]}-1600.webp`}
          width="1600"
          height="900"
          alt={`${leadProject.data.title} project preview`}
          fetchpriority="high"
        />
      </picture>
      <span class="v5-hero-project-index">01 / Founder project</span>
      <strong>{leadProject.data.title}</strong>
      <span class="v5-hero-project-action"
        >View case study <span aria-hidden="true">&nearr;</span></span
      >
    </a>

    <div class="v5-hero-intro">
      <p>
        I build focused websites and custom software, then stay with the difficult parts until the
        result works as one product.
      </p>
      <a href="#selected-work">Move through the work</a>
    </div>

    <nav class="v5-hero-routes" aria-label="Primary service routes">
      {
        services.map((service, index) => (
          <a href={`/services/${service.id}/`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{service.data.title}</strong>
          </a>
        ))
      }
    </nav>

    <div class="v5-hero-axis" aria-hidden="true">
      <span>Scroll</span>
      <i></i>
    </div>
  </section>

  <section class="melt-chapter" aria-labelledby="melt-title" data-melt-section>
    <h2 class="sr-only" id="melt-title">Work that holds when the difficult parts arrive</h2>
    <div class="melt-sticky">
      <p class="melt-kicker">The useful part starts after the first impression.</p>
      <svg
        class="melt-type"
        viewBox="0 0 1600 700"
        role="img"
        aria-label="Work that holds"
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <filter id="type-melt" x="-12%" y="-12%" width="124%" height="150%">
            <feTurbulence
              data-melt-turbulence
              type="fractalNoise"
              baseFrequency="0.006 0.018"
              numOctaves="2"
              seed="19"
              result="noise"></feTurbulence>
            <feDisplacementMap
              data-melt-displacement
              in="SourceGraphic"
              in2="noise"
              scale="0"
              xChannelSelector="R"
              yChannelSelector="B"></feDisplacementMap>
          </filter>
        </defs>
        <g class="melt-type-clean" aria-hidden="true">
          <text x="210" y="270" textLength="1180" lengthAdjust="spacingAndGlyphs">WORK</text>
          <text x="210" y="555" textLength="1180" lengthAdjust="spacingAndGlyphs">HOLDS</text>
        </g>
        <g class="melt-type-fluid" filter="url(#type-melt)" aria-hidden="true">
          <text x="210" y="270" textLength="1180" lengthAdjust="spacingAndGlyphs">WORK</text>
          <text x="210" y="555" textLength="1180" lengthAdjust="spacingAndGlyphs">HOLDS</text>
        </g>
      </svg>
      <div class="melt-caption">
        <p>
          The interface can move, bend, and change state. The evidence underneath still has to be
          direct, readable, and true.
        </p>
        <span>Scroll-bound type study / original implementation</span>
      </div>
    </div>
  </section>

  <section
    class="curve-work"
    id="selected-work"
    aria-labelledby="selected-work-title"
    aria-describedby="selected-work-instructions"
    data-curve-work
    tabindex="0"
  >
    <div class="curve-work-sticky">
      <header class="curve-work-header">
        <p id="selected-work-instructions">Selected work / drag the room with scroll</p>
        <h2 id="selected-work-title">Projects on one continuous curve.</h2>
      </header>

      <ol class="curve-track" data-curve-track>
        {
          projects.map((project, index) => (
            <li
              class="curve-card"
              data-curve-card
              data-project-index={index}
              data-project-title={project.data.title}
              data-project-description={project.data.description}
              data-project-route={project.data.route}
              data-project-tone={project.id}
            >
              <a href={project.data.route}>
                <picture>
                  <source media="(max-width: 720px)" srcset={`${mediaBase[project.id]}-960.webp`} />
                  <img
                    src={`${mediaBase[project.id]}-1600.webp`}
                    width="1600"
                    height="900"
                    alt={`${project.data.title} project preview`}
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                </picture>
                <span class="curve-card-meta">
                  <small>{String(index + 1).padStart(2, '0')}</small>
                  <strong>{project.data.title}</strong>
                  <small>{project.data.status}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="curve-work-detail" aria-live="polite">
        <span data-curve-count>01 / {String(projects.length).padStart(2, '0')}</span>
        <div>
          <h3 data-curve-title>{leadProject.data.title}</h3>
          <p data-curve-description>{leadProject.data.description}</p>
        </div>
        <a data-curve-link href={leadProject.data.route}
          >Open project <span aria-hidden="true">&nearr;</span></a
        >
      </div>

      <div class="curve-controls" aria-label="Project controls">
        <button type="button" data-curve-previous aria-label="Previous project">&larr;</button>
        <button type="button" data-curve-next aria-label="Next project">&rarr;</button>
      </div>
    </div>
  </section>

  <section class="evidence-chapter" aria-labelledby="evidence-title">
    <div class="evidence-index" aria-hidden="true">03</div>
    <div class="evidence-heading">
      <p>What remains when the motion stops</p>
      <h2 id="evidence-title">Clear boundaries. Real work. No invented outcomes.</h2>
    </div>
    <div class="evidence-copy">
      <p>
        Boilabin is the founder project. SoctuKit, the UIU Discord Bot, and Salty Potato AI expose
        different parts of how I think, build, test, and explain.
      </p>
      <a href="/work/">Open the complete work index</a>
    </div>
  </section>

  <section class="route-ledger" aria-labelledby="route-ledger-title">
    <h2 class="sr-only" id="route-ledger-title">Services and stories</h2>
    <div class="route-ledger-label">
      <p>Two ways to work together</p>
      <span>04 / Services</span>
    </div>
    <ol>
      {
        services.map((service, index) => (
          <li>
            <a href={`/services/${service.id}/`}>
              <small>{String(index + 1).padStart(2, '0')}</small>
              <strong>{service.data.title}</strong>
              <span>{service.data.intro}</span>
              <i aria-hidden="true">&nearr;</i>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="route-ledger-label route-ledger-label-stories">
      <p>Notes from work I can explain first-hand</p>
      <span>05 / Stories</span>
    </div>
    <ol>
      {
        articles.map((article, index) => (
          <li>
            <a href={`/writing/${article.id}/`}>
              <small>{String(index + 1).padStart(2, '0')}</small>
              <strong>{article.data.title}</strong>
              <span>{article.data.description}</span>
              <i aria-hidden="true">&nearr;</i>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="home-contact" aria-labelledby="home-contact-title">
    <div class="home-contact-sticky">
      <p class="home-contact-kicker">Have a real constraint?</p>

      <div class="home-contact-type">
        <h2 class="home-contact-title" id="home-contact-title">
          <span>Bring me</span>
          <span>the situation.</span>
        </h2>
      </div>

      <a href="/contact/">Start a project <span aria-hidden="true">&nearr;</span></a>
    </div>
  </section>

  <script>
    import '../scripts/home-state';
  </script>
</BaseLayout>
