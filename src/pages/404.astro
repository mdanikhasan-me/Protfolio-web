---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | MD Anik Hasan"
  description="The requested page could not be found."
  noindex={true}
>
  <section class="plain-hero">
    <p class="eyebrow">Build record 404</p>
    <h1>This part is not in the archive.</h1>
    <p class="lede">
      The address may have changed. Return home, browse verified work, or search the site.
    </p>
    <div class="actions">
      <a class="action action-primary" href="/">Go home</a>
      <a class="action" href="/work/">Browse work</a>
      <a class="text-link" href="/search/">Search</a>
    </div>
  </section>
</BaseLayout>
