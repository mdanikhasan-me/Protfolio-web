---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact MD Anik Hasan | Start a Website or Software Project"
  description="Contact routes for website development, custom software, open-source collaboration, Boilabin seller interest, and professional enquiries."
>
  <PageHero
    eyebrow="Start a build"
    title="Choose the conversation before choosing the channel."
    intro="Paid work, open-source collaboration, and Boilabin seller interest have different contexts. Keeping them separate makes the first message easier to understand."
    workshop="Start a Build"
  />

  <section class="contact-routes" aria-labelledby="contact-routes-title">
    <h2 id="contact-routes-title">Contact routes</h2>
    <ol>
      <li>
        <p class="list-index">01</p>
        <div>
          <h3><a href="/hire/?service=website">Website development</a></h3>
          <p>For business, ecommerce, product, startup, portfolio, or focused web work.</p>
        </div>
      </li>
      <li>
        <p class="list-index">02</p>
        <div>
          <h3><a href="/hire/?service=software">Custom software</a></h3>
          <p>For desktop software, internal tools, automation, prototypes, or business systems.</p>
        </div>
      </li>
      <li>
        <p class="list-index">03</p>
        <div>
          <h3><a href="/open-source/">Open-source collaboration</a></h3>
          <p>For a repository, issue, or practical technical contribution with clear context.</p>
        </div>
      </li>
      <li>
        <p class="list-index">04</p>
        <div>
          <h3><a href="/boilabin/seller-interest/">Boilabin seller interest</a></h3>
          <p>For the planned, invitation-only future seller programme—not software enquiries.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="contact-fallback" aria-labelledby="fallback-title">
    <p class="eyebrow">Verified fallback</p>
    <h2 id="fallback-title">The direct email address is not published yet.</h2>
    <p>
      I will not guess or reuse an unverified contact address. Until the final professional email is
      supplied, you can prepare a project brief through this site and use my verified public GitHub
      profile for a professional contact route.
    </p>
    <p>
      <a class="action action-primary" href="https://github.com/mdanikhasan-dev"
        >Open GitHub profile</a
      >
    </p>
    <p class="privacy-note">
      This site currently sends no form data, stores no enquiry, and runs no analytics.
    </p>
  </section>
</BaseLayout>
