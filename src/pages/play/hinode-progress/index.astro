---
import '../../../hinode/ui/hinode-progress.css';

const title = 'Hinode City v2 — candidate, not approved';
const description =
  'Current topology, runtime, reference, safety, and validation state for the Hinode City v2 candidate.';
const routes: ReadonlyArray<readonly [string, string, string]> = [
  ['01', 'Hinode Main Loop', 'One island-wide primary loop'],
  ['02', 'Downtown Commercial Spine', 'North-central secondary route'],
  ['03', 'Port Connector', 'Downtown-to-east industrial connection'],
  ['04', 'Canal to Waterfront', 'Centre-west to south secondary route'],
  ['05', 'Southwest Alley Route', '3.2m compact one-way route'],
  ['06', 'Northwest Touge', 'Switchbacks over a coherent terrain mass'],
  ['07', 'Southern Waterfront', 'Scenic route with seawall protection'],
  ['08', 'Downtown Flyover', '7m grade-separated waterfront bypass'],
  ['09', 'Port Underpass', 'Below-grade two-way connector'],
  ['10', 'Canal Market Cut', 'Intentional compact shortcut'],
  ['11', 'Dock Service Cut', 'Intentional port shortcut'],
];
const overlays: ReadonlyArray<readonly [string, string, string]> = [
  ['topology', 'Topology', 'Connected nodes, routes, junctions, and shortcuts.'],
  [
    'road-hierarchy',
    'Road hierarchy',
    'Primary, secondary, alley, touge, waterfront, flyover, and underpass classes.',
  ],
  ['elevation', 'Elevation', 'Grade, touge climb, flyover deck, and underpass depth.'],
  ['road-edges', 'Road edges', 'Left/right edge class and width on all eleven routes.'],
  ['safety', 'Safety', 'Guardrail, crash barrier, seawall, canal rail, and tunnel-wall routes.'],
  [
    'district-density',
    'District density',
    'Five distinct districts with intentionally different density.',
  ],
  ['collision', 'Collision', 'Boundary and water-edge volumes plus route safety barriers.'],
];
const views: ReadonlyArray<readonly [string, string]> = [
  ['main-loop-v2', 'Main loop'],
  ['secondary-v2', 'Secondary road'],
  ['alley-v2', 'Alley'],
  ['touge-v2', 'Touge'],
  ['waterfront-v2', 'Waterfront'],
  ['port-v2', 'Port'],
  ['flyover-approach-v2', 'Flyover approach'],
  ['flyover-lower-v2', 'Flyover lower road'],
  ['underpass-entrance-v2', 'Underpass entrance'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06101b" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main class="review-shell" data-review-root>
      <header class="topbar">
        <a class="wordmark" href="/play/hinode-city/">
          <span>Hinode City</span>
          <small>日の出市 / Honshu Coast</small>
        </a>
        <p class="topbar-state">
          <span class="state-dot"></span>V2 candidate / awaiting user decision
        </p>
        <nav aria-label="Open Hinode work surfaces">
          <a href="/play/hinode-city/">Drive</a>
          <a href="/play/hinode-editor/">Edit</a>
          <a href="/play/hinode-v2-evidence/">Evidence</a>
          <a href="/">Portfolio</a>
        </nav>
      </header>

      <section class="hero">
        <div>
          <p class="eyebrow">HINODE CITY / INTERNAL CANDIDATE CHECKPOINT</p>
          <h1>V2 candidate,<br />not approved.</h1>
          <p class="lede">
            The rejected v1 layout remains retained but is no longer loaded by default. This page
            reports only the new north-up v2 topology and the browser candidate generated from it.
          </p>
        </div>
        <div class="hero-actions">
          <a class="primary-action" href="/play/hinode-v2-evidence/">Open candidate evidence</a>
          <a href="/play/hinode-city/">Open playable candidate</a>
          <a href="/play/hinode-editor/?overlay=topology">Open topology editor</a>
        </div>
      </section>

      <section class="status-grid" aria-label="Candidate status">
        <article>
          <span>STATUS</span><strong>candidate_awaiting_user_approval</strong><small
            >No acceptance implied</small>
        </article>
        <article>
          <span>TOPOLOGY</span><strong>Validated</strong><small
            >Bounds, connectivity, gradients, crossings</small>
        </article>
        <article><span>MAP</span><strong>500 × 350 m</strong><small>North is +Z</small></article>
        <article>
          <span>NETWORK</span><strong>11 routes</strong><small
            >1 loop / 3 connectors / 2 shortcuts</small>
        </article>
        <article>
          <span>EDGES</span><strong>11 / 11 classified</strong><small
            >Left, right, drainage, protection</small>
        </article>
        <article>
          <span>STRUCTURES</span><strong>3 crossings</strong><small
            >Flyover over secondary, loop, and dock cut</small>
        </article>
      </section>

      <section class="review-section">
        <header class="section-heading">
          <div><span>01</span><p>REFERENCE RESPONSE</p></div>
          <h2>
            District hierarchy and road language, compressed into a playable 500 × 350m candidate.
          </h2>
        </header>
        <div class="browser-grid">
          <figure>
            <img
              src="/hinode/references/v2/master-overview.webp"
              alt="Supplied Hinode City overview reference"
            />
            <figcaption>
              <strong>Supplied overview</strong><span
                >Northwest touge, southwest alley, central core, eastern port, and southern
                waterfront.</span>
            </figcaption>
          </figure>
          <figure>
            <img
              src="/hinode/references/v2/road-hierarchy.webp"
              alt="Supplied road hierarchy reference"
            />
            <figcaption>
              <strong>Road hierarchy</strong><span
                >Distinct widths, curves, edges, and connector behavior.</span>
            </figcaption>
          </figure>
          <figure>
            <img
              src="/hinode/references/v2/driver-composition.webp"
              alt="Supplied driver composition reference"
            />
            <figcaption>
              <strong>Driver composition</strong><span
                >Readable secondary merge with a flyover visible above.</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="review-section">
        <header class="section-heading">
          <div><span>02</span><p>AUTHORED NETWORK</p></div>
          <h2>One main loop, district routes, meaningful connectors, and only two shortcuts.</h2>
        </header>
        <div class="route-grid">
          {
            routes.map(([index, name, role]) => (
              <article>
                <>
                  <span>{index}</span>
                  <strong>{name}</strong>
                  <small>{role}</small>
                </>
              </article>
            ))
          }
        </div>
      </section>

      <section class="review-section">
        <header class="section-heading">
          <div><span>03</span><p>CANDIDATE MAPS</p></div>
          <h2>Every map is generated from the v2 candidate, not the rejected v1 scene.</h2>
        </header>
        <div class="overlay-grid">
          {
            overlays.map(([id, label, note]) => (
              <a href={`/play/hinode-editor/?overlay=${id}`}>
                <>
                  <span>{label}</span>
                  <small>{note}</small>
                  <b>Open overlay →</b>
                </>
              </a>
            ))
          }
        </div>
      </section>

      <section class="review-section">
        <header class="section-heading">
          <div><span>04</span><p>DRIVER VIEWS</p></div>
          <h2>
            Runtime viewpoints cover the hierarchy, both levels of the flyover, and the underpass
            entrance.
          </h2>
        </header>
        <div class="overlay-grid">
          {
            views.map(([id, label]) => (
              <a href={`/play/hinode-city/?review=${id}&view=driver&quality=low`}>
                <>
                  <span>{label}</span>
                  <small>{id}</small>
                  <b>Open view →</b>
                </>
              </a>
            ))
          }
        </div>
      </section>

      <section class="review-section">
        <header class="section-heading">
          <div><span>05</span><p>BOUNDARIES</p></div>
          <h2>What this candidate does and does not claim.</h2>
        </header>
        <div class="truth-grid">
          <article>
            <strong>Included</strong><p>
              Validated 2D topology, generated browser geometry, explicit edges, visible protection,
              coherent terrain masses, flyover/underpass structures, five lighting-zone types,
              playable handling, and inspection overlays.
            </p>
          </article>
          <article>
            <strong>Still provisional</strong><p>
              Map acceptance, hero-car choice, detailed architecture, vegetation placement, neon
              content, final materials, traffic, audio, and polish remain outside this candidate
              decision.
            </p>
          </article>
        </div>
      </section>

      <footer class="review-footer">
        <span>HINODE CITY V2 — CANDIDATE, NOT APPROVED</span>
        <nav>
          <a href="/play/hinode-v2-evidence/">Evidence</a><a href="/play/hinode-city/">Drive</a><a
            href="/play/hinode-editor/">Editor</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
