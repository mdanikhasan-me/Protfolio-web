---
import HinodePreviewLayout from '../../../hinode/ui/HinodePreviewLayout.astro';
---

<HinodePreviewLayout
  title="Hinode City Vertical Slice | MD Anik Hasan"
  description="A playable 75 by 60 metre browser driving study for the new Hinode City."
>
  <main class="hinode-preview" data-hinode-preview data-phase="loading">
    <canvas
      class="hinode-canvas"
      data-hinode-canvas
      tabindex="0"
      aria-label="Playable Hinode City alley driving scene"></canvas>

    <a class="hinode-back" href="/">← Portfolio</a>

    <section class="hinode-loading" aria-labelledby="hinode-title">
      <div class="hinode-loading-panel">
        <p class="hinode-kicker">Clean-room vertical slice / 75 × 60 m</p>
        <h1 id="hinode-title">Hinode City</h1>
        <p class="hinode-loading-copy">
          One compact alley, one original coupe, and one visible flyover. This is a real-time
          browser driving study built from new Blender source.
        </p>
        <progress
          class="hinode-progress"
          data-loading-progress
          max="1"
          value="0"
          aria-label="Hinode asset loading progress"></progress>
        <div class="hinode-loading-meta" aria-live="polite">
          <span data-loading-status>Loading baked street geometry</span>
          <span data-loading-percent>0%</span>
        </div>
        <button class="hinode-start" data-start-drive type="button" disabled>Preparing slice</button
        >
      </div>
    </section>

    <aside class="hinode-hud" aria-label="Driving status">
      <span class="hinode-hud-label">Speed</span>
      <span aria-hidden="true"></span>
      <strong class="hinode-speed" data-speed>00</strong>
      <span class="hinode-unit">km/h</span>
      <span class="hinode-gear" data-gear>GEAR N</span>
    </aside>

    <aside class="hinode-debug" data-debug-metrics hidden aria-label="Renderer debug metrics">
      <span>FPS <strong data-debug-fps>—</strong></span>
      <span>Calls <strong data-debug-calls>—</strong></span>
      <span>Tris <strong data-debug-triangles>—</strong></span>
      <span>Road <strong data-debug-road>—</strong></span>
      <span>Position <strong data-debug-position>—</strong></span>
      <span>Contacts <strong data-debug-collisions>—</strong></span>
    </aside>

    <p class="hinode-controls">
      W/S accelerate & brake · A/D steer · Space handbrake · R reset · C camera · Esc pause
    </p>
    <p class="hinode-status" data-drive-status role="status" aria-live="polite"></p>

    <section class="hinode-pause" data-pause-panel hidden aria-labelledby="pause-title">
      <div class="hinode-pause-panel">
        <p class="hinode-kicker">Drive paused</p>
        <h2 id="pause-title">Take a breath.</h2>
        <p class="hinode-loading-copy">
          The simulation and controls are stopped. Continue when you are ready.
        </p>
        <button class="hinode-resume" data-resume-drive type="button">Resume drive</button>
      </div>
    </section>
  </main>

  <script>
    import '../../../hinode/ui/hinode-preview';
  </script>
</HinodePreviewLayout>
