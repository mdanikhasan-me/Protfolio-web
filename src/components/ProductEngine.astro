---
const cells = Array.from({ length: 168 }, (_, index) => {
  const x = index % 12;
  const y = Math.floor(index / 12);
  const ranges: Array<[number, number]> = [
    [4, 7],
    [3, 8],
    [3, 8],
    [3, 8],
    [4, 7],
    [4, 7],
    [5, 6],
    [3, 8],
    [2, 9],
    [1, 10],
    [1, 10],
    [0, 11],
    [0, 11],
    [0, 11],
  ];
  const range = ranges[y];
  const active = range ? x >= range[0] && x <= range[1] : false;
  const removable = active && (x * 7 + y * 11) % 13 === 0;
  return { x, y, active, removable };
});

const outputs = [
  { code: 'WEB', label: 'Website systems', detail: 'Structure · interface · search' },
  { code: 'WIN', label: 'Native software', detail: 'Workflow · state · install' },
  { code: 'LAB', label: 'Learning systems', detail: 'Tokens · training · inference' },
] as const;
---

<figure class="product-engine" aria-labelledby="engine-title engine-caption">
  <div class="engine-heading">
    <p class="eyebrow">Product engine · abstract portrait mode</p>
    <h2 id="engine-title">Raw units become useful systems.</h2>
  </div>

  <div class="engine-board">
    <section class="engine-input" aria-label="Abstract portrait input">
      <div class="engine-plate">
        <span>Input 01</span>
        <span>Portrait channel</span>
      </div>
      <div class="pixel-portrait" aria-hidden="true">
        {
          cells.map((cell) => (
            <span
              class:list={[
                'portrait-pixel',
                cell.active && 'is-active',
                cell.removable && 'is-removable',
              ]}
              style={`--x:${cell.x};--y:${cell.y}`}
            />
          ))
        }
      </div>
      <p class="engine-note">No facial likeness. An approved portrait can replace this source.</p>
    </section>

    <div class="engine-transfer" aria-hidden="true">
      <span class="transfer-label">Build path</span>
      <span class="transfer-line"></span>
      <span class="traveller traveller-one"></span>
      <span class="traveller traveller-two"></span>
      <span class="traveller traveller-three"></span>
      <span class="traveller traveller-four"></span>
      <span class="traveller traveller-five"></span>
    </div>

    <section class="engine-output" aria-label="Product outputs">
      <div class="engine-plate">
        <span>Output 03</span>
        <span>Working products</span>
      </div>
      <ol>
        {
          outputs.map((output, index) => (
            <li>
              <span class="output-code">{output.code}</span>
              <div>
                <strong>{output.label}</strong>
                <small>{output.detail}</small>
              </div>
              <span class="output-state">{String(index + 1).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <figcaption id="engine-caption">
    The portrait channel stays abstract until Anik supplies an approved source. The motion shows
    selected pixel units moving into interface, software, and learning-system outputs; all essential
    meaning remains in HTML.
  </figcaption>
</figure>
