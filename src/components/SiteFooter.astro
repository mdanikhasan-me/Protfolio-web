---
import FooterBrand from './FooterBrand.astro';
import { SITE, SOCIAL_PROFILES } from '../config/site';

const home = Astro.url.pathname === '/';
const year = new Date().getUTCFullYear();
---

<div class:list={['footer-ending', { 'footer-ending-home': home }]}>
  {home && <div class="footer-outro" data-footer-outro aria-label="ANIK">
    <div class="footer-outro-screen">
      <canvas class="footer-outro-field" aria-hidden="true"></canvas>
      <FooterBrand outro />
    </div>
  </div>}
<footer class="site-footer studio-footer" data-studio-footer>
  <div class="footer-bottom">
    <nav aria-label="Footer navigation">
      <a href="/">Top</a>
      <a href="/work/">Work</a>
      <a href="/services/">Services</a>
      <a href="/writing/">Writing</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/search/">Search</a>
    </nav>
    <nav class="footer-social" aria-label="Social links">
      <a href={`mailto:${SITE.email}`}>Email</a>
      <a href={SITE.discord} rel="me">Discord</a>
      {SOCIAL_PROFILES.map(profile => <a href={profile.href} rel="me">{profile.label}</a>)}
    </nav>
    <div class="footer-inquiry">
      <a href="/contact/">Contact <span aria-hidden="true">↗</span></a>
      <a href="/hire/">Work together <span aria-hidden="true">↗</span></a>
      <a class="footer-privacy" href="/privacy/">Privacy</a>
    </div>
  </div>
  <p class="footer-copyright">© {year} {SITE.name}</p>
  {!home && <FooterBrand />}

</footer>

</div>
<script>
  import '../scripts/footer-outro';
</script>
