---
import { PRIMARY_NAVIGATION, SITE } from '../config/site';

const pathname = Astro.url.pathname;

function isCurrent(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header" data-site-header>
  <div class="header-main shell">
    <a class="site-mark" href="/" aria-label={`${SITE.name}, home`}>
      <span class="site-mark-monogram" aria-hidden="true">AH</span>
      <span>{SITE.name}</span>
    </a>

    <nav class="desktop-navigation" aria-label="Primary navigation">
      <ul>
        {
          PRIMARY_NAVIGATION.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="mobile-navigation" data-mobile-navigation>
      <summary aria-label="Open navigation">Menu</summary>
      <nav aria-label="Mobile navigation">
        <ul>
          {
            PRIMARY_NAVIGATION.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href="/search/">Search</a></li>
        </ul>
      </nav>
    </details>

    <a
      class="header-search"
      href="/search/"
      aria-current={isCurrent('/search/') ? 'page' : undefined}>Search</a
    >
  </div>
</header>

<script>
  const mobileNavigation = document.querySelector<HTMLDetailsElement>('[data-mobile-navigation]');

  if (mobileNavigation) {
    const syncNavigationState = () => {
      document.body.classList.toggle('nav-open', mobileNavigation.open);
    };

    mobileNavigation.addEventListener('toggle', syncNavigationState);
    mobileNavigation.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileNavigation.open = false;
      });
    });
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileNavigation.open) {
        mobileNavigation.open = false;
        mobileNavigation.querySelector('summary')?.focus();
      }
    });
  }
</script>
