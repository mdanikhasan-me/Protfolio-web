---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE } from '../config/site';
import type { SchemaNode } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  schema?: SchemaNode | SchemaNode[];
  bodyClass?: string;
  hideHeader?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  type = 'website',
  schema = [],
  bodyClass = '',
  hideHeader = false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.origin,
  homeLocation: {
    '@type': 'Place',
    name: SITE.location,
  },
  sameAs: [SITE.github],
};
const schemaNodes = [personSchema, ...(Array.isArray(schema) ? schema : [schema])];
const routeParts = canonicalPath.split('/').filter(Boolean);
const section = routeParts[0] ?? 'home';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eee7d5" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} writing`}
      href="/rss.xml"
    />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaNodes)} />
    <slot name="head" />
  </head>
  <body
    class={bodyClass}
    data-section={section}
    data-pagefind-ignore={noindex ? 'all' : undefined}
  >
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-frame">
      {!hideHeader && <SiteHeader />}
      <main id="main-content" tabindex="-1" data-pagefind-body={!noindex ? true : undefined}>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
