{
  "name": "md-anik-hasan-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "visual:capture": "node scripts/capture-local.mjs",
    "dev": "astro dev",
    "build": "npm run check && astro build && pagefind --site dist",
    "build:astro": "astro build",
    "check": "npm run typecheck && npm run lint",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit --passWithNoTests",
    "test:e2e:hinode": "playwright test tests/e2e/hinode",
    "validate:hinode": "npm run validate:hinode:topology && npm run validate:hinode:layout",
    "validate:hinode:city": "npm run validate:hinode",
    "validate:hinode:topology": "node tools/validation/hinode/validate-hinode-v2-topology.mjs",
    "build:hinode:candidate": "node tools/validation/hinode/build-hinode-v2-candidate.mjs",
    "validate:hinode:layout": "node tools/validation/hinode/validate-hinode-layout.mjs",
    "review:hinode": "node tools/validation/hinode/update-hinode-v2-candidate-status.mjs",
    "capture:hinode": "node tools/validation/hinode/capture-hinode-v2-candidate.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource-variable/anybody": "^5.2.7",
    "@fontsource-variable/archivo": "^5.2.7",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astro": "^7.1.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
